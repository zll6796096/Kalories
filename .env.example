# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.6-flash

# Firebase App Check is mandatory for both paid POST routes. The Firebase iOS
# app ID is the GOOGLE_APP_ID from the separately approved registration, not
# the Apple bundle identifier. These are public identifiers, not credentials.
APP_CHECK_ENFORCEMENT=required
FIREBASE_PROJECT_ID=replace-with-approved-project-id
FIREBASE_IOS_APP_ID=replace-with-approved-firebase-ios-app-id

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
